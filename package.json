{
  "name": "deanstav-logger",
  "version": "1.0.0",
  "description": "A lightweight, TypeScript-first logging utility for server-side logging in Next.js and Node.js applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "logger",
    "logging",
    "monitoring",
    "typescript",
    "nextjs",
    "next.js",
    "server-side",
    "fetch"
  ],
  "author": "Dean Stavenuiter",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
